<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<connectionStrings>
		<add name="ClinicDB"
			 connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=SmileClinicDB;Integrated Security=True;Encrypt=False;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<!-- 🔴 هذا هو السطر المهم -->
	<appSettings>
		<add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
	</appSettings>

	<system.web>
		<compilation debug="true" targetFramework="4.7.2" />
		<httpRuntime targetFramework="4.7.2" />
	</system.web>

</configuration>
